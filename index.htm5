<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AL-JAMIATUL ISMAILIYA LILBANAT</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f5f7f6;
    color:#222;
}

.header{
    background:#075b3b;
    color:white;
    text-align:center;
    padding:35px 15px;
}

.header h1{
    font-size:28px;
    margin-bottom:8px;
}

.header p{
    font-size:15px;
}

.container{
    max-width:850px;
    margin:30px auto;
    padding:15px;
}

.menu{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:18px;
}

.card{
    background:white;
    border:0;
    border-radius:15px;
    padding:28px 15px;
    font-size:18px;
    font-weight:bold;
    color:#075b3b;
    box-shadow:0 4px 12px rgba(0,0,0,.12);
    cursor:pointer;
    transition:.2s;
}

.card:hover{
    transform:translateY(-3px);
    background:#075b3b;
    color:white;
}

.page{
    display:none;
    background:white;
    padding:25px;
    border-radius:15px;
    box-shadow:0 4px 12px rgba(0,0,0,.12);
}

.page h2{
    color:#075b3b;
    margin-bottom:18px;
}

.page p{
    line-height:1.7;
    margin-bottom:12px;
}

.back{
    margin-top:20px;
    padding:11px 20px;
    border:0;
    border-radius:8px;
    background:#075b3b;
    color:white;
    cursor:pointer;
}

.box{
    background:#f0f7f4;
    padding:15px;
    border-radius:10px;
    margin:10px 0;
}

input,select,textarea{
    width:100%;
    padding:12px;
    margin:8px 0 15px;
    border:1px solid #ccc;
    border-radius:8px;
}

.submit{
    padding:12px 20px;
    border:0;
    border-radius:8px;
    background:#075b3b;
    color:white;
    cursor:pointer;
}

footer{
    margin-top:40px;
    padding:20px;
    text-align:center;
    background:#075b3b;
    color:white;
}

@media(max-width:600px){
    .menu{
        grid-template-columns:1fr;
    }

    .header h1{
        font-size:22px;
    }
}
</style>
</head>

<body>

<div class="header">
    <h1>AL-JAMIATUL ISMAILIYA LILBANAT</h1>
    <p>Official School Website</p>
</div>

<div class="container">

<!-- HOME MENU -->

<div id="home" class="menu">

<button class="card" onclick="openPage('events')">
📅 Events
</button>

<button class="card" onclick="openPage('result')">
📊 Result
</button>

<button class="card" onclick="openPage('admission')">
📝 Admission Form
</button>

<button class="card" onclick="openPage('courses')">
📚 Courses
</button>

<button class="card" onclick="openPage('fees')">
💰 Fees Info
</button>

<button class="card" onclick="openPage('contact')">
📞 Contact Us
</button>

<button class="card" onclick="openPage('links')">
🔗 Links
</button>

</div>


<!-- EVENTS -->

<div id="events" class="page">

<h2>📅 Events</h2>

<div class="box">
<strong>School Events</strong>
<p>Latest school events and programmes will be displayed here.</p>
</div>

<button class="back" onclick="home()">← Back</button>

</div>


<!-- RESULT -->

<div id="result" class="page">

<h2>📊 Result</h2>

<p>Enter your Roll Number to check your result.</p>

<input type="text" id="roll" placeholder="Roll Number">

<button class="submit" onclick="checkResult()">
Check Result
</button>

<div id="resultBox"></div>

<button class="back" onclick="home()">← Back</button>

</div>


<!-- ADMISSION -->

<div id="admission" class="page">

<h2>📝 Admission Form</h2>

<label>Student Name</label>
<input type="text" placeholder="Enter Student Name">

<label>Father / Guardian Name</label>
<input type="text" placeholder="Enter Father / Guardian Name">

<label>Class</label>
<select>
<option>Select Class</option>
<option>Nursery</option>
<option>LKG</option>
<option>UKG</option>
<option>Class 1</option>
<option>Class 2</option>
<option>Class 3</option>
<option>Class 4</option>
<option>Class 5</option>
<option>Class 6</option>
<option>Class 7</option>
<option>Class 8</option>
<option>Class 9</option>
<option>Class 10</option>
<option>Class 11</option>
<option>Class 12</option>
</select>

<label>Mobile Number</label>
<input type="tel" placeholder="Mobile Number">

<label>Address</label>
<textarea placeholder="Address"></textarea>

<button class="submit"
onclick="alert('Your admission form has been submitted.')">
Submit
</button>

<button class="back" onclick="home()">← Back</button>

</div>


<!-- COURSES -->

<div id="courses" class="page">

<h2>📚 Courses</h2>

<div class="box">
<strong>School Education</strong>
<p>Classes and subjects offered by the school will be listed here.</p>
</div>

<div class="box">
<strong>Islamic Education</strong>
<p>Islamic education details will be displayed here.</p>
</div>

<button class="back" onclick="home()">← Back</button>

</div>


<!-- FEES -->

<div id="fees" class="page">

<h2>💰 Fees Information</h2>

<div class="box">
<strong>Admission Fee</strong>
<p>Information will be updated by the school.</p>
</div>

<div class="box">
<strong>Monthly Fee</strong>
<p>Information will be updated by the school.</p>
</div>

<div class="box">
<strong>Annual Fee</strong>
<p>Information will be updated by the school.</p>
</div>

<button class="back" onclick="home()">← Back</button>

</div>


<!-- CONTACT -->

<div id="contact" class="page">

<h2>📞 Contact Us</h2>

<div class="box">
<strong>School</strong>
<p>AL-JAMIATUL ISMAILIYA LILBANAT</p>
</div>

<div class="box">
<strong>Address</strong>
<p>School address will be added here.</p>
</div>

<div class="box">
<strong>Phone</strong>
<p>School phone number will be added here.</p>
</div>

<div class="box">
<strong>Email</strong>
<p>School email will be added here.</p>
</div>

<button class="back" onclick="home()">← Back</button>

</div>


<!-- LINKS -->

<div id="links" class="page">

<h2>🔗 Important Links</h2>

<div class="box">
<a href="#" target="_blank">Online Admission</a>
</div>

<div class="box">
<a href="#" target="_blank">Student Portal</a>
</div>

<div class="box">
<a href="#" target="_blank">School Notice</a>
</div>

<button class="back" onclick="home()">← Back</button>

</div>

</div>


<footer>
© 2026 AL-JAMIATUL ISMAILIYA LILBANAT
</footer>


<script>

function openPage(id){

    document.getElementById("home").style.display="none";

    let pages=document.querySelectorAll(".page");

    pages.forEach(function(page){
        page.style.display="none";
    });

    document.getElementById(id).style.display="block";

    window.scrollTo(0,0);
}

function home(){

    let pages=document.querySelectorAll(".page");

    pages.forEach(function(page){
        page.style.display="none";
    });

    document.getElementById("home").style.display="grid";

    window.scrollTo(0,0);
}

function checkResult(){

    let roll=document.getElementById("roll").value;
    let box=document.getElementById("resultBox");

    if(roll==""){
        box.innerHTML=
        "<div class='box'>Please enter Roll Number.</div>";
        return;
    }

    box.innerHTML=
    "<div class='box'>Result for Roll Number <strong>"
    + roll +
    "</strong> will be displayed here.</div>";
}

</script>

</body>
</html>
